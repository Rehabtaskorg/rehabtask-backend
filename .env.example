# Server
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL="http://localhost:3000"

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/rehabtask?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STIPE_PUBLISHABLE_KEY=pk_test
STRIPE_WEBHOOK__SECRET=whsec_xxx
STRIPE_CONNECT_CLIENT_ID=ca_xxx

# Resend
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=RehabTask <noreply@rehabtask.com>
ADMIN_EMAIL=admin@rehabtask.com

# Google Maps
GOOGLE_MAPS_API_KEY=AIZaSyXXX

# Sentry
SENTRY_DSN=https://xxx@sentry.io/xxx

# Better Stack (Logs & Event Monitoring)
BETTERSTACK_LOG_TOKEN=your-betterstack-log-source-token


# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000