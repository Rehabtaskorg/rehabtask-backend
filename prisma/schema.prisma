generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String            @id @db.Uuid
  email             String            @unique @db.VarChar(255)
  passwordHash      String            @default("") @map("password_hash")
  role              UserRole
  emailVerified     Boolean           @default(false) @map("email_verified")
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  auditLogs         AuditLog[]
  customerProfile   CustomerProfile?
  uploadedDocuments LicenseDocument[] @relation("UserDocuments")
  verifiedDocuments LicenseDocument[] @relation("DocumentVerifier")
  receivedMessages  Message[]         @relation("ReceivedMessages")
  sentMessages      Message[]         @relation("SentMessages")
  patientProfile    Patient?
  configUpdates     SystemConfig[]
  therapistProfile  TherapistProfile?
  disputes          Dispute[]

  @@index([email])
  @@index([role, isActive])
  @@map("users")
}

model CustomerProfile {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @unique @map("user_id") @db.Uuid
  customerType     CustomerType     @map("customer_type")
  fullName         String           @map("full_name") @db.VarChar(255)
  agencyName       String?          @map("agency_name") @db.VarChar(255)
  phone            String           @db.VarChar(20)
  location         String?
  stripeCustomerId String?          @unique @map("stripe_customer_id") @db.VarChar(255)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  bookings         Booking[]
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  patients         Patient[]        @relation("AgencyPatients")
  payments         Payment[]
  subscriptions    Subscription[]
  requests         TherapyRequest[]
  reviews          Review[]

  @@index([userId])
  @@index([customerType])
  @@index([stripeCustomerId])
  @@map("customer_profiles")
}

model Patient {
  id                 String           @id @default(uuid()) @db.Uuid
  agencyId           String           @map("agency_id") @db.Uuid
  email              String           @db.VarChar(255)
  fullName           String           @map("full_name") @db.VarChar(255)
  phone              String?          @db.VarChar(20)
  userId             String?          @unique @map("user_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  bookingsForPatient Booking[]        @relation("PatientBookings")
  messagesAbout      Message[]        @relation("PatientMessages")
  agency             CustomerProfile  @relation("AgencyPatients", fields: [agencyId], references: [id], onDelete: Cascade)
  user               User?            @relation(fields: [userId], references: [id])
  requestsForPatient TherapyRequest[] @relation("PatientRequests")

  @@index([agencyId])
  @@index([userId])
  @@index([email])
  @@map("patients")
}

model TherapistProfile {
  id                       String                 @id @default(uuid()) @db.Uuid
  userId                   String                 @unique @map("user_id") @db.Uuid
  fullName                 String                 @map("full_name") @db.VarChar(255)
  phone                    String                 @db.VarChar(20)
  yearsOfExperience        Int?                   @map("years_of_experience")
  primaryLicenseType       String?                @map("primary_license_type") @db.VarChar(100)
  professionalSummary      String?                @map("professional_summary")
  profilePhotoUrl          String?                @map("profile_photo_url")
  specialization           String?
  licenseNumber            String?                @unique @map("license_number") @db.VarChar(100)
  licenseState             String?                @map("license_state") @db.VarChar(2)
  workArea                 String?                @map("work_area")
  stripeAccountId          String?                @unique @map("stripe_account_id") @db.VarChar(255)
  stripeOnboardingComplete Boolean                @default(false) @map("stripe_onboarding_complete")
  backgroundCheckConsent   Boolean?               @default(false) @map("background_check_consent")
  backgroundCheckSignature String?                @map("background_check_signature") @db.VarChar(255)
  backgroundCheckDate      DateTime?              @map("background_check_date") @db.Timestamptz(3)
  backgroundCheckStatus    BackgroundCheckStatus? @default(pending) @map("background_check_status")
  approvalStatus           ApprovalStatus         @default(review) @map("approval_status")
  approvedBy               String?                @map("approved_by") @db.Uuid
  approvedAt               DateTime?              @map("approved_at") @db.Timestamptz(3)
  rejectionReason          String?                @map("rejection_reason")
  onboardingStep           Int                    @default(1) @map("onboarding_step")
  onboardingComplete       Boolean                @default(false) @map("onboarding_complete")
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  availability             Availability[]
  bookings                 Booking[]
  licenseDocuments         LicenseDocument[]
  offers                   Offer[]
  payments                 Payment[]
  user                     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workAreas                WorkArea[]
  reviews                  Review[]

  @@index([userId])
  @@index([approvalStatus, createdAt])
  @@index([stripeAccountId])
  @@index([licenseNumber])
  @@index([backgroundCheckStatus])
  @@map("therapist_profiles")
}

model LicenseDocument {
  id            String           @id @default(uuid()) @db.Uuid
  therapistId   String           @map("therapist_id") @db.Uuid
  documentUrl   String           @map("document_url")
  documentType  String           @map("document_type") @db.VarChar(50)
  fileName      String           @map("file_name") @db.VarChar(255)
  fileSize      Int              @map("file_size")
  uploadedAt    DateTime         @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  bucket        String?          @default("license-documents") @db.VarChar(50)
  deletedAt     DateTime?        @map("deleted_at") @db.Timestamptz(3)
  isDeleted     Boolean          @default(false) @map("is_deleted")
  mimeType      String?          @map("mime_type") @db.VarChar(100)
  reject_reason String?
  status        String?          @default("pending") @db.VarChar(20)
  uploadIp      String?          @map("upload_ip") @db.VarChar(45)
  userId        String?          @map("user_id") @db.Uuid
  verifiedAt    DateTime?        @map("verified_at") @db.Timestamptz(3)
  verifiedBy    String?          @map("verified_by") @db.Uuid
  therapist     TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  user          User?            @relation("UserDocuments", fields: [userId], references: [id], onDelete: Cascade)
  verifier      User?            @relation("DocumentVerifier", fields: [verifiedBy], references: [id])

  @@index([therapistId])
  @@index([userId], map: "idx_license_documents_user_active")
  @@index([status, uploadedAt])
  @@index([therapistId, status])
  @@map("license_documents")
}

model Availability {
  id          String           @id @default(uuid()) @db.Uuid
  therapistId String           @map("therapist_id") @db.Uuid
  dayOfWeek   DayOfWeek        @map("day_of_week")
  isEnabled   Boolean          @default(false) @map("is_enabled")
  timeBlocks  Json             @default("[]") @map("time_blocks")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  therapist   TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@unique([therapistId, dayOfWeek])
  @@index([therapistId])
  @@index([dayOfWeek])
  @@map("availability")
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  customerId           String             @map("customer_id") @db.Uuid
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id") @db.VarChar(255)
  stripeCustomerId     String             @map("stripe_customer_id") @db.VarChar(255)
  planType             SubscriptionPlan   @map("plan_type")
  status               SubscriptionStatus
  currentPeriodStart   DateTime?          @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd     DateTime?          @map("current_period_end") @db.Timestamptz(3)
  therapistLimit       Int                @map("therapist_limit")
  requestLimit         Int                @map("request_limit")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer             CustomerProfile    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, status])
  @@index([stripeSubscriptionId])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model TherapyRequest {
  id            String          @id @default(uuid()) @db.Uuid
  customerId    String          @map("customer_id") @db.Uuid
  patientId     String?         @map("patient_id") @db.Uuid
  serviceType   String          @map("service_type") @db.VarChar(100)
  description   String
  preferredDate DateTime        @map("preferred_date") @db.Timestamptz(3)
  location      String
  latitude      Decimal         @db.Decimal(10, 8)
  longitude     Decimal         @db.Decimal(11, 8)
  status        RequestStatus
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  offers        Offer[]
  messages      Message[]
  customer      CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  patient       Patient?        @relation("PatientRequests", fields: [patientId], references: [id])

  @@index([customerId, status, createdAt])
  @@index([patientId, status, createdAt])
  @@index([status, createdAt])
  @@index([latitude, longitude])
  @@index([serviceType, status])
  @@map("therapy_requests")
}

model Offer {
  id                String           @id @default(uuid()) @db.Uuid
  requestId         String           @map("request_id") @db.Uuid
  therapistId       String           @map("therapist_id") @db.Uuid
  rate              Decimal          @db.Decimal(10, 2)
  sessionType       String           @map("session_type") @db.VarChar(20)
  proposedDate      DateTime         @map("proposed_date") @db.Timestamptz(3)
  description       String
  status            OfferStatus
  expiresAt         DateTime         @map("expires_at") @db.Timestamptz(3)
  withdrawnAt       DateTime?        @map("withdrawn_at") @db.Timestamptz(3)
  changeRequestNote String?          @map("change_request_note")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  booking           Booking?
  messages          Message[]
  request           TherapyRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  therapist         TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([requestId, status])
  @@index([therapistId, status, createdAt])
  @@index([status, expiresAt])
  @@index([therapistId, requestId])
  @@map("offers")
}

model Booking {
  id              String           @id @default(uuid()) @db.Uuid
  offerId         String           @unique @map("offer_id") @db.Uuid
  customerId      String           @map("customer_id") @db.Uuid
  patientId       String?          @map("patient_id") @db.Uuid
  therapistId     String           @map("therapist_id") @db.Uuid
  scheduledDate   DateTime         @map("scheduled_date") @db.Timestamptz(3)
  rate            Decimal          @db.Decimal(10, 2)
  sessionType     String           @map("session_type") @db.VarChar(20)
  status          BookingStatus
  proposedNewDate DateTime?        @map("proposed_new_date") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer        CustomerProfile  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  offer           Offer            @relation(fields: [offerId], references: [id], onDelete: Cascade)
  patient         Patient?         @relation("PatientBookings", fields: [patientId], references: [id])
  therapist       TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  payment         Payment?
  session         Session?
  messages        Message[]
  review          Review?
  disputes        Dispute[]

  @@index([customerId, status, scheduledDate])
  @@index([patientId, status, scheduledDate])
  @@index([therapistId, status, scheduledDate])
  @@index([status, scheduledDate])
  @@index([offerId])
  @@map("bookings")
}

model Session {
  id                    String        @id @default(uuid()) @db.Uuid
  bookingId             String        @unique @map("booking_id") @db.Uuid
  scheduledDate         DateTime      @map("scheduled_date") @db.Timestamptz(3)
  status                SessionStatus
  startedAt             DateTime?     @map("started_at") @db.Timestamptz(3)
  completedAt           DateTime?     @map("completed_at") @db.Timestamptz(3)
  confirmedByCustomerAt DateTime?     @map("confirmed_by_customer_at") @db.Timestamptz(3)
  cancellationReason    String?       @map("cancellation_reason")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  booking               Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status, completedAt])
  @@map("sessions")
}

model Payment {
  id                    String           @id @default(uuid()) @db.Uuid
  bookingId             String           @unique @map("booking_id") @db.Uuid
  customerId            String           @map("customer_id") @db.Uuid
  therapistId           String           @map("therapist_id") @db.Uuid
  stripePaymentIntentId String?          @unique @map("stripe_payment_intent_id") @db.VarChar(255)
  stripeTransferId      String?          @unique @map("stripe_transfer_id") @db.VarChar(255)
  amount                Decimal          @db.Decimal(10, 2)
  platformFee           Decimal          @map("platform_fee") @db.Decimal(10, 2)
  therapistPayout       Decimal          @map("therapist_payout") @db.Decimal(10, 2)
  status                PaymentStatus
  escrowedAt            DateTime?        @map("escrowed_at") @db.Timestamptz(3)
  releasedAt            DateTime?        @map("released_at") @db.Timestamptz(3)
  refundedAt            DateTime?        @map("refunded_at") @db.Timestamptz(3)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  booking               Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer              CustomerProfile  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  therapist             TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([stripePaymentIntentId])
  @@index([customerId, createdAt])
  @@index([therapistId, status, releasedAt])
  @@index([status, escrowedAt])
  @@map("payments")
}

model Message {
  id          String @id @default(uuid()) @db.Uuid
  senderId    String @map("sender_id") @db.Uuid
  recipientId String @map("recipient_id") @db.Uuid

  requestId String? @map("request_id") @db.Uuid
  offerId   String? @map("offer_id") @db.Uuid
  bookingId String? @map("booking_id") @db.Uuid
  patientId String? @map("patient_id") @db.Uuid

  content String    @db.Text
  readAt  DateTime? @map("read_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sender    User            @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User            @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  request   TherapyRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  offer     Offer?          @relation(fields: [offerId], references: [id], onDelete: Cascade)
  booking   Booking?        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  patient   Patient?        @relation("PatientMessages", fields: [patientId], references: [id])

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
  @@index([requestId, createdAt])
  @@index([offerId, createdAt])
  @@index([bookingId, createdAt])
  @@index([patientId, createdAt])
  @@map("messages")
}

model WorkArea {
  id          String           @id @default(uuid()) @db.Uuid
  therapistId String           @map("therapist_id") @db.Uuid
  city        String           @db.VarChar(100)
  state       String           @db.VarChar(50)
  latitude    Decimal          @db.Decimal(10, 8)
  longitude   Decimal          @db.Decimal(11, 8)
  radiusMiles Int              @default(25) @map("radius_miles")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  therapist   TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([therapistId])
  @@index([latitude, longitude])
  @@map("work_areas")
}

model Review {
  id          String           @id @default(uuid()) @db.Uuid
  bookingId   String           @unique @map("booking_id") @db.Uuid
  customerId  String           @map("customer_id") @db.Uuid
  therapistId String           @map("therapist_id") @db.Uuid
  rating      Int
  comment     String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking  Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer CustomerProfile  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  therapist TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([therapistId, createdAt])
  @@index([customerId])
  @@index([bookingId])
  @@map("reviews")
}

model FAQ {
  id        String   @id @default(uuid()) @db.Uuid
  question  String   @db.Text
  answer    String   @db.Text
  category  String   @db.VarChar(100)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([category, sortOrder])
  @@index([isActive])
  @@map("faqs")
}

model Dispute {
  id          String        @id @default(uuid()) @db.Uuid
  ticketId    String        @unique @map("ticket_id") @db.VarChar(20)
  userId      String        @map("user_id") @db.Uuid
  bookingId   String?       @map("booking_id") @db.Uuid
  type        DisputeType
  description String        @db.Text
  status      DisputeStatus @default(open)
  resolution  String?       @db.Text
  resolvedAt  DateTime?     @map("resolved_at") @db.Timestamptz(3)
  resolvedBy  String?       @map("resolved_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([ticketId])
  @@map("disputes")
}


model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  changes    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model SystemConfig {
  key         String   @id @db.VarChar(100)
  value       String
  description String?
  dataType    String   @map("data_type") @db.VarChar(20)
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  updater     User?    @relation(fields: [updatedBy], references: [id])

  @@index([key])
  @@map("system_config")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  customer
  therapist
  admin
}

enum CustomerType {
  individual
  agency
}

enum ApprovalStatus {
  review
  approved
  rejected
  pending
}

enum SubscriptionPlan {
  free
  premium
}

enum SubscriptionStatus {
  active
  inactive
  cancelled
  past_due
}

enum RequestStatus {
  created
  offers_received
  offers_accepted
  completed
  cancelled
}

enum OfferStatus {
  pending
  accepted
  rejected
  expired
  withdrawn
  change_requested
}

enum BookingStatus {
  pending
  confirmed
  in_progress
  completed
  cancelled
  reschedule_requested
}

enum SessionStatus {
  scheduled
  completed_by_therapist
  confirmed_by_customer
  cancelled
}

enum PaymentStatus {
  intent_created
  escrowed
  released
  refunded
  failed
}

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

enum BackgroundCheckStatus {
  pending
  in_progress
  completed
  failed
}

enum DisputeStatus {
  open
  under_review
  resolved
  closed
}

enum DisputeType {
  billing
  service_quality
  no_show
  communication
  other
}
