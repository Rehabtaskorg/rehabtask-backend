generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String               @id @db.Uuid
  email                      String               @unique @db.VarChar(255)
  passwordHash               String               @default("") @map("password_hash")
  role                       UserRole
  emailVerified              Boolean              @default(false) @map("email_verified")
  isActive                   Boolean              @default(true) @map("is_active")
  deactivatedAt              DateTime?            @map("deactivated_at") @db.Timestamptz(3)
  createdAt                  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  auditLogs                  AuditLog[]
  customerProfile            CustomerProfile?
  uploadedDocuments          LicenseDocument[]    @relation("UserDocuments")
  verifiedDocuments          LicenseDocument[]    @relation("DocumentVerifier")
  receivedMessages           Message[]            @relation("ReceivedMessages")
  sentMessages               Message[]            @relation("SentMessages")
  patientProfile             Patient?
  configUpdates              SystemConfig[]
  therapistProfile           TherapistProfile?
  disputes                   Dispute[]            @relation("DisputeFiledBy")
  assignedDisputes           Dispute[]            @relation("DisputeAssignedAdmin")
  notifications              Notification[]
  subAdminProfile            SubAdminProfile?     @relation("SubAdminUser")
  createdSubAdmins           SubAdminProfile[]    @relation("SubAdminCreatedBy")
  commissionConfigs          CommissionConfig[]
  directConversationsAsUser1 DirectConversation[] @relation("DirectConvUser1")
  directConversationsAsUser2 DirectConversation[] @relation("DirectConvUser2")
  uploadedAttachments        MessageAttachment[]  @relation("AttachmentUploader")

  @@index([email])
  @@index([role, isActive])
  @@map("users")
}

model CustomerProfile {
  id                          String           @id @default(uuid()) @db.Uuid
  userId                      String           @unique @map("user_id") @db.Uuid
  customerType                CustomerType     @map("customer_type")
  fullName                    String           @map("full_name") @db.VarChar(255)
  agencyName                  String?          @map("agency_name") @db.VarChar(255)
  phone                       String?          @db.VarChar(20)
  location                    String?
  stripeCustomerId            String?          @unique @map("stripe_customer_id") @db.VarChar(255)
  stripeAccountId             String?          @unique @map("stripe_account_id") @db.VarChar(255)
  stripeOnboardingComplete    Boolean          @default(false) @map("stripe_onboarding_complete")
  createdAt                   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  bookings                    Booking[]
  user                        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  patients                    Patient[]        @relation("AgencyPatients")
  payments                    Payment[]
  subscriptions               Subscription[]
  requests                    TherapyRequest[]
  reviews                     Review[]
  customerRefunds             CustomerRefund[]

  @@index([userId])
  @@index([customerType])
  @@index([stripeCustomerId])
  @@index([stripeAccountId])
  @@map("customer_profiles")
}

model Patient {
  id                 String           @id @default(uuid()) @db.Uuid
  agencyId           String           @map("agency_id") @db.Uuid
  email              String?          @db.VarChar(255)
  fullName           String           @map("full_name") @db.VarChar(255)
  phone              String?          @db.VarChar(20)
  addressLine1       String?          @map("address_line_1") @db.VarChar(255)
  addressLine2       String?          @map("address_line_2") @db.VarChar(255)
  city               String?          @db.VarChar(100)
  state              String?          @db.VarChar(50)
  zipCode            String?          @map("zip_code") @db.VarChar(10)
  latitude           Decimal?         @db.Decimal(10, 8)
  longitude          Decimal?         @db.Decimal(11, 8)
  dateOfBirth         DateTime?        @map("date_of_birth") @db.Date
  certificationStart  DateTime?        @map("certification_start") @db.Date
  certificationEnd    DateTime?        @map("certification_end") @db.Date
  userId             String?          @unique @map("user_id") @db.Uuid
  isActive           Boolean          @default(true) @map("is_active")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  bookingsForPatient Booking[]        @relation("PatientBookings")
  messagesAbout      Message[]        @relation("PatientMessages")
  agency             CustomerProfile  @relation("AgencyPatients", fields: [agencyId], references: [id], onDelete: Cascade)
  user               User?            @relation(fields: [userId], references: [id])
  requestsForPatient TherapyRequest[] @relation("PatientRequests")

  @@index([agencyId])
  @@index([userId])
  @@index([email])
  @@index([latitude, longitude])
  @@map("patients")
}

model TherapistProfile {
  id                       String                 @id @default(uuid()) @db.Uuid
  userId                   String                 @unique @map("user_id") @db.Uuid
  fullName                 String                 @map("full_name") @db.VarChar(255)
  phone                    String?                @db.VarChar(20)
  dateOfBirth              DateTime?              @map("date_of_birth") @db.Date
  addressLine1             String?                @map("address_line_1") @db.VarChar(255)
  addressLine2             String?                @map("address_line_2") @db.VarChar(255)
  city                     String?                @db.VarChar(100)
  state                    String?                @db.VarChar(2)
  zipCode                  String?                @map("zip_code") @db.VarChar(10)
  latitude                 Decimal?               @db.Decimal(10, 8)
  longitude                Decimal?               @db.Decimal(11, 8)
  emergencyContactName     String?                @map("emergency_contact_name") @db.VarChar(255)
  emergencyContactPhone    String?                @map("emergency_contact_phone") @db.VarChar(20)
  npiNumber                String?                @unique @map("npi_number") @db.VarChar(10)
  yearsOfExperience        Int?                   @map("years_of_experience")
  primaryLicenseType       String?                @map("primary_license_type") @db.VarChar(100)
  professionalSummary      String?                @map("professional_summary")
  profilePhotoUrl          String?                @map("profile_photo_url")
  specialization           String?
  licenseNumber            String?                @unique @map("license_number") @db.VarChar(100)
  licenseState             String?                @map("license_state") @db.VarChar(2)
  workArea                 String?                @map("work_area")
  stripeAccountId          String?                @unique @map("stripe_account_id") @db.VarChar(255)
  stripeOnboardingComplete Boolean                @default(false) @map("stripe_onboarding_complete")
  backgroundCheckConsent   Boolean?               @default(false) @map("background_check_consent")
  backgroundCheckSignature String?                @map("background_check_signature") @db.VarChar(255)
  backgroundCheckDate      DateTime?              @map("background_check_date") @db.Timestamptz(3)
  backgroundCheckStatus    BackgroundCheckStatus? @default(pending) @map("background_check_status")
  approvalStatus           ApprovalStatus         @default(review) @map("approval_status")
  approvedBy               String?                @map("approved_by") @db.Uuid
  approvedAt               DateTime?              @map("approved_at") @db.Timestamptz(3)
  rejectionReason          String?                @map("rejection_reason")
  onboardingStep           Int                    @default(1) @map("onboarding_step")
  onboardingComplete       Boolean                @default(false) @map("onboarding_complete")
  ratePerVisit             Decimal?               @map("rate_per_visit") @db.Decimal(10, 2)
  attemptedVisitRate       Decimal?               @map("attempted_visit_rate") @db.Decimal(10, 2)
  planTier                 TherapistPlan          @default(basic) @map("plan_tier")
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  availability             Availability[]
  bookings                 Booking[]
  licenseDocuments         LicenseDocument[]
  offers                   Offer[]
  payments                 Payment[]
  user                     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workAreas                WorkArea[]
  reviews                  Review[]
  directRequests           TherapyRequest[]       @relation("DirectRequests")

  @@index([userId])
  @@index([approvalStatus, createdAt])
  @@index([planTier, approvalStatus])
  @@index([stripeAccountId])
  @@index([licenseNumber])
  @@index([backgroundCheckStatus])
  @@map("therapist_profiles")
}

model VisitType {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(10)
  name            String           @db.VarChar(100)
  discipline      String           @db.VarChar(50)
  isActive        Boolean          @default(true) @map("is_active")
  sortOrder       Int              @default(0) @map("sort_order")
  customerVisible Boolean          @default(true) @map("customer_visible")
  isEvaluation    Boolean          @default(false) @map("is_evaluation")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  offers          Offer[]
  therapyRequests TherapyRequest[]
  bookings        Booking[]

  @@index([discipline, isActive])
  @@index([discipline, customerVisible, isActive])
  @@index([code])
  @@map("visit_types")
}

model LicenseDocument {
  id            String           @id @default(uuid()) @db.Uuid
  therapistId   String           @map("therapist_id") @db.Uuid
  documentUrl   String           @map("document_url")
  documentType  String           @map("document_type") @db.VarChar(50)
  fileName      String           @map("file_name") @db.VarChar(255)
  fileSize      Int              @map("file_size")
  uploadedAt    DateTime         @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  bucket        String?          @default("license-documents") @db.VarChar(50)
  deletedAt     DateTime?        @map("deleted_at") @db.Timestamptz(3)
  isDeleted     Boolean          @default(false) @map("is_deleted")
  mimeType      String?          @map("mime_type") @db.VarChar(100)
  reject_reason String?
  status        String?          @default("pending") @db.VarChar(20)
  uploadIp      String?          @map("upload_ip") @db.VarChar(45)
  userId        String?          @map("user_id") @db.Uuid
  verifiedAt    DateTime?        @map("verified_at") @db.Timestamptz(3)
  verifiedBy    String?          @map("verified_by") @db.Uuid
  therapist     TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  user          User?            @relation("UserDocuments", fields: [userId], references: [id], onDelete: Cascade)
  verifier      User?            @relation("DocumentVerifier", fields: [verifiedBy], references: [id])

  @@index([therapistId])
  @@index([userId], map: "idx_license_documents_user_active")
  @@index([status, uploadedAt])
  @@index([therapistId, status])
  @@map("license_documents")
}

model Availability {
  id          String           @id @default(uuid()) @db.Uuid
  therapistId String           @map("therapist_id") @db.Uuid
  dayOfWeek   DayOfWeek        @map("day_of_week")
  isEnabled   Boolean          @default(false) @map("is_enabled")
  timeBlocks  Json             @default("[]") @map("time_blocks")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  therapist   TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@unique([therapistId, dayOfWeek])
  @@index([therapistId])
  @@index([dayOfWeek])
  @@map("availability")
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  customerId           String             @map("customer_id") @db.Uuid
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id") @db.VarChar(255)
  stripeCustomerId     String?            @map("stripe_customer_id") @db.VarChar(255)
  stripePriceId        String?            @map("stripe_price_id") @db.VarChar(255)
  planType             SubscriptionPlan   @map("plan_type")
  billingInterval      BillingInterval?   @map("billing_interval")
  status               SubscriptionStatus
  currentPeriodStart   DateTime?          @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd     DateTime?          @map("current_period_end") @db.Timestamptz(3)
  trialEndsAt          DateTime?          @map("trial_ends_at") @db.Timestamptz(3)
  gracePeriodEndsAt    DateTime?          @map("grace_period_ends_at") @db.Timestamptz(3)
  cancelledAt          DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  cancelReason         String?            @map("cancel_reason")
  stripeScheduleId     String?            @map("stripe_schedule_id") @db.VarChar(255)
  therapistLimit       Int                @map("therapist_limit")
  requestLimit         Int                @map("request_limit")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer             CustomerProfile    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, status])
  @@index([stripeSubscriptionId])
  @@index([status, currentPeriodEnd])
  @@index([status, trialEndsAt])
  @@index([status, gracePeriodEndsAt])
  @@map("subscriptions")
}

model TherapyRequest {
  id            String          @id @default(uuid()) @db.Uuid
  customerId    String          @map("customer_id") @db.Uuid
  patientId     String?         @map("patient_id") @db.Uuid
  serviceType   String          @map("service_type") @db.VarChar(100)
  description   String
  rate          Decimal?        @db.Decimal(10, 2)
  visitType     String?         @map("visit_type") @db.VarChar(100)
  visitTypeId   String?         @map("visit_type_id") @db.Uuid
  emr           String?         @db.VarChar(100)
  preferredDate DateTime        @map("preferred_date") @db.Timestamptz(3)
  location      String
  latitude      Decimal         @db.Decimal(10, 8)
  longitude     Decimal         @db.Decimal(11, 8)
  status        RequestStatus
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  visitsPerWeek     Int?              @map("visits_per_week")
  numberOfWeeks     Int?              @map("number_of_weeks")
  requestType       RequestType       @default(PUBLIC) @map("request_type")
  targetTherapistId String?           @map("target_therapist_id") @db.Uuid
  offers            Offer[]
  messages          Message[]
  customer          CustomerProfile   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  patient           Patient?          @relation("PatientRequests", fields: [patientId], references: [id])
  visitTypeRef      VisitType?        @relation(fields: [visitTypeId], references: [id])
  targetTherapist   TherapistProfile? @relation("DirectRequests", fields: [targetTherapistId], references: [id], onDelete: SetNull)

  @@index([customerId, status, createdAt])
  @@index([patientId, status, createdAt])
  @@index([status, createdAt])
  @@index([latitude, longitude])
  @@index([serviceType, status])
  @@index([visitTypeId])
  @@index([targetTherapistId, status])
  @@index([customerId, requestType, status])
  @@map("therapy_requests")
}

model Offer {
  id                String      @id @default(uuid()) @db.Uuid
  requestId         String      @map("request_id") @db.Uuid
  therapistId       String      @map("therapist_id") @db.Uuid
  rate              Decimal     @db.Decimal(10, 2)
  sessionType       String      @map("session_type") @db.VarChar(20)
  proposedDate      DateTime    @map("proposed_date") @db.Timestamptz(3)
  description       String
  status            OfferStatus
  expiresAt         DateTime    @map("expires_at") @db.Timestamptz(3)
  withdrawnAt       DateTime?   @map("withdrawn_at") @db.Timestamptz(3)
  changeRequestNote String?     @map("change_request_note")

  attemptedVisitRate Decimal? @map("attempted_visit_rate") @db.Decimal(10, 2)

  visitTypeId   String?          @map("visit_type_id") @db.Uuid
  visitType     String?          @map("visit_type") @db.VarChar(100)
  visitsPerWeek Int?             @map("visits_per_week")
  numberOfWeeks Int?             @map("number_of_weeks")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  booking       Booking?
  messages      Message[]
  request       TherapyRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  therapist     TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  visitTypeRef  VisitType?       @relation(fields: [visitTypeId], references: [id])

  @@index([requestId, status])
  @@index([therapistId, status, createdAt])
  @@index([status, expiresAt])
  @@index([therapistId, requestId])
  @@map("offers")
}

model Booking {
  id                       String           @id @default(uuid()) @db.Uuid
  offerId                  String           @unique @map("offer_id") @db.Uuid
  customerId               String           @map("customer_id") @db.Uuid
  patientId                String?          @map("patient_id") @db.Uuid
  therapistId              String           @map("therapist_id") @db.Uuid
  scheduledDate            DateTime         @map("scheduled_date") @db.Timestamptz(3)
  rate                     Decimal          @db.Decimal(10, 2)
  attemptedVisitRate       Decimal?         @map("attempted_visit_rate") @db.Decimal(10, 2)
  sessionType              String           @map("session_type") @db.VarChar(20)
  status                   BookingStatus
  visitType                String?          @map("visit_type") @db.VarChar(100)
  visitTypeId              String?          @map("visit_type_id") @db.Uuid
  visitsPerWeek            Int?             @map("visits_per_week")
  numberOfWeeks            Int?             @map("number_of_weeks")
  proposedNewDate          DateTime?        @map("proposed_new_date") @db.Timestamptz(3)
  paymentReminderSentAt    DateTime?        @map("payment_reminder_sent_at") @db.Timestamptz(3)
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer                 CustomerProfile  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  offer                    Offer            @relation(fields: [offerId], references: [id], onDelete: Cascade)
  patient                  Patient?         @relation("PatientBookings", fields: [patientId], references: [id])
  therapist                TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  visitTypeRef             VisitType?       @relation(fields: [visitTypeId], references: [id])
  earlyCompletionRequested  Boolean?         @default(false) @map("early_completion_requested")
  earlyCompletionReason     String?          @map("early_completion_reason")
  earlyCompletionBy         String?          @map("early_completion_by") @db.VarChar(20)
  cancellationReason        String?          @map("cancellation_reason")
  cancellationRequestedAt   DateTime?        @map("cancellation_requested_at") @db.Timestamptz(3)
  cancellationRequestedBy   String?          @map("cancellation_requested_by") @db.VarChar(20)
  preCancellationStatus     String?          @map("pre_cancellation_status") @db.VarChar(50)
  payment                   Payment?
  sessions                 Session[]
  messages                 Message[]
  review                   Review?
  disputes                 Dispute[]
  customerRefunds          CustomerRefund[]

  @@index([customerId, status, scheduledDate])
  @@index([patientId, status, scheduledDate])
  @@index([therapistId, status, scheduledDate])
  @@index([status, scheduledDate])
  @@index([offerId])
  @@index([visitTypeId])
  @@map("bookings")
}

model Session {
  id                    String        @id @default(uuid()) @db.Uuid
  bookingId             String        @map("booking_id") @db.Uuid
  sessionNumber         Int?          @map("session_number")
  visitTitle            String?       @map("visit_title") @db.VarChar(100)
  scheduledDate         DateTime?     @map("scheduled_date") @db.Timestamptz(3)
  status                SessionStatus
  startedAt             DateTime?     @map("started_at") @db.Timestamptz(3)
  completedAt           DateTime?     @map("completed_at") @db.Timestamptz(3)
  confirmedByCustomerAt DateTime?     @map("confirmed_by_customer_at") @db.Timestamptz(3)
  cancellationReason        String?       @map("cancellation_reason")
  cancellationRequestedAt   DateTime?     @map("cancellation_requested_at") @db.Timestamptz(3)
  cancellationRequestedBy   String?       @map("cancellation_requested_by") @db.VarChar(20)
  preCancellationStatus     String?       @map("pre_cancellation_status") @db.VarChar(50)

  revisionRequestedAt     DateTime? @map("revision_requested_at") @db.Timestamptz(3)
  revisionReason          String?   @map("revision_reason")
  revisionDueBy           DateTime? @map("revision_due_by") @db.Timestamptz(3)
  revisionCount           Int       @default(0) @map("revision_count")
  revisionLastSubmittedAt DateTime? @map("revision_last_submitted_at") @db.Timestamptz(3)

  missedReason String?       @map("missed_reason") @db.VarChar(500)
  missedBy     MissedByRole? @map("missed_by")
  missedAt     DateTime?     @map("missed_at") @db.Timestamptz(3)

  attemptedRateCharged Decimal?      @map("attempted_rate_charged") @db.Decimal(10, 2)
  attemptedReason      String?       @map("attempted_reason") @db.VarChar(500)
  attemptedAt          DateTime?     @map("attempted_at") @db.Timestamptz(3)
  attemptedBy          MissedByRole? @map("attempted_by")

  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  booking         Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payout          SessionPayout?
  customerRefunds CustomerRefund[]

  @@index([bookingId])
  @@index([status, completedAt])
  @@index([bookingId, sessionNumber])
  @@map("sessions")
}

model Payment {
  id                    String           @id @default(uuid()) @db.Uuid
  bookingId             String           @unique @map("booking_id") @db.Uuid
  customerId            String           @map("customer_id") @db.Uuid
  therapistId           String           @map("therapist_id") @db.Uuid
  stripePaymentIntentId String?          @unique @map("stripe_payment_intent_id") @db.VarChar(255)
  stripeTransferId      String?          @unique @map("stripe_transfer_id") @db.VarChar(255)
  amount                Decimal          @db.Decimal(10, 2)
  platformFee           Decimal          @map("platform_fee") @db.Decimal(10, 2)
  therapistPayout       Decimal          @map("therapist_payout") @db.Decimal(10, 2)
  releasedAmount        Decimal          @default(0) @map("released_amount") @db.Decimal(10, 2)
  releasedFee           Decimal?         @map("released_fee") @db.Decimal(10, 2)
  status                PaymentStatus
  escrowedAt            DateTime?        @map("escrowed_at") @db.Timestamptz(3)
  releasedAt            DateTime?        @map("released_at") @db.Timestamptz(3)
  refundedAt            DateTime?        @map("refunded_at") @db.Timestamptz(3)
  stripeRefundId        String?          @unique @map("stripe_refund_id") @db.VarChar(255)
  refundedAmount        Decimal          @default(0) @map("refunded_amount") @db.Decimal(10, 2)
  idempotencyKey        String?          @unique @map("idempotency_key") @db.VarChar(255)
  threeDSecureResult    String?          @map("three_d_secure_result") @db.VarChar(30)
  threeDSecureVersion   String?          @map("three_d_secure_version") @db.VarChar(10)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  booking               Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer              CustomerProfile  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  therapist             TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  sessionPayouts        SessionPayout[]
  customerRefunds       CustomerRefund[]

  @@index([bookingId])
  @@index([stripePaymentIntentId])
  @@index([customerId, createdAt])
  @@index([therapistId, status, releasedAt])
  @@index([status, escrowedAt])
  @@map("payments")
}

model SessionPayout {
  id               String   @id @default(uuid()) @db.Uuid
  sessionId        String   @unique @map("session_id") @db.Uuid
  paymentId        String   @map("payment_id") @db.Uuid
  stripeTransferId String   @unique @map("stripe_transfer_id") @db.VarChar(255)
  amount           Decimal  @db.Decimal(10, 2)
  platformFee      Decimal  @map("platform_fee") @db.Decimal(10, 2)
  therapistPayout  Decimal  @map("therapist_payout") @db.Decimal(10, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([stripeTransferId])
  @@map("session_payouts")
}

model CustomerRefund {
  id                    String               @id @default(uuid()) @db.Uuid
  customerId            String               @map("customer_id") @db.Uuid
  paymentId             String               @map("payment_id") @db.Uuid
  bookingId             String               @map("booking_id") @db.Uuid
  sessionId             String?              @map("session_id") @db.Uuid
  amount                Decimal              @db.Decimal(10, 2)
  status                CustomerRefundStatus
  stripeTransferId      String?              @unique @map("stripe_transfer_id") @db.VarChar(255)
  stripeRefundId        String?              @unique @map("stripe_refund_id") @db.VarChar(255)
  reason                String?              @db.VarChar(255)
  connectReminderSentAt DateTime?            @map("connect_reminder_sent_at") @db.Timestamptz(3)
  fallbackRefundAt      DateTime?            @map("fallback_refund_at") @db.Timestamptz(3)
  transferredAt         DateTime?            @map("transferred_at") @db.Timestamptz(3)
  expiresAt             DateTime?            @map("expires_at") @db.Timestamptz(3)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer              CustomerProfile      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payment               Payment              @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  booking               Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  session               Session?             @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([customerId, status])
  @@index([status, expiresAt])
  @@index([paymentId])
  @@index([bookingId])
  @@index([sessionId])
  @@map("customer_refunds")
}

model ProcessedWebhookEvent {
  stripeEventId String   @id @map("stripe_event_id") @db.VarChar(255)
  eventType     String   @map("event_type") @db.VarChar(100)
  processedAt   DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@index([processedAt])
  @@map("processed_webhook_events")
}

model DirectConversation {
  id        String   @id @default(uuid()) @db.Uuid
  user1Id   String   @map("user1_id") @db.Uuid
  user2Id   String   @map("user2_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user1       User                @relation("DirectConvUser1", fields: [user1Id], references: [id])
  user2       User                @relation("DirectConvUser2", fields: [user2Id], references: [id])
  messages    Message[]
  attachments MessageAttachment[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@map("direct_conversations")
}

model Message {
  id          String @id @default(uuid()) @db.Uuid
  senderId    String @map("sender_id") @db.Uuid
  recipientId String @map("recipient_id") @db.Uuid

  requestId      String? @map("request_id") @db.Uuid
  offerId        String? @map("offer_id") @db.Uuid
  bookingId      String? @map("booking_id") @db.Uuid
  patientId      String? @map("patient_id") @db.Uuid
  conversationId String? @map("conversation_id") @db.Uuid

  content    String    @db.Text
  systemType String?   @map("system_type") @db.VarChar(50)
  replyToId  String?   @map("reply_to_id") @db.Uuid
  readAt     DateTime? @map("read_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sender       User                @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient    User                @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  request      TherapyRequest?     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  offer        Offer?              @relation(fields: [offerId], references: [id], onDelete: Cascade)
  booking      Booking?            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  patient      Patient?            @relation("PatientMessages", fields: [patientId], references: [id])
  conversation DirectConversation? @relation(fields: [conversationId], references: [id])
  attachments  MessageAttachment[]
  replyTo      Message?            @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]           @relation("MessageReplies")

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
  @@index([requestId, createdAt])
  @@index([offerId, createdAt])
  @@index([bookingId, createdAt])
  @@index([patientId, createdAt])
  @@index([conversationId, createdAt])
  @@map("messages")
}

model WorkArea {
