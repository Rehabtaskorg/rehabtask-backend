model MessageAttachment {
  id             String @id @default(uuid()) @db.Uuid
  messageId      String @map("message_id") @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid
  uploadedById   String @map("uploaded_by_id") @db.Uuid

  fileName    String @map("file_name") @db.VarChar(255)
  fileSize    Int    @map("file_size")
  mimeType    String @map("mime_type") @db.VarChar(100)
  storagePath String @map("storage_path")
  bucket      String @default("message-attachments") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message      Message            @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation DirectConversation @relation(fields: [conversationId], references: [id])
  uploadedBy   User               @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  @@index([messageId])
  @@index([conversationId, createdAt])
  @@map("message_attachments")
}

// Tracks attempted-visit refunds that failed after the therapist payout succeeded.
// A background job retries these until resolved or permanently failed.
model PendingRefundRetry {
  id                    String                   @id @default(uuid()) @db.Uuid
  sessionId             String                   @map("session_id") @db.Uuid
  bookingId             String                   @map("booking_id") @db.Uuid
  paymentId             String                   @map("payment_id") @db.Uuid
  customerId            String                   @map("customer_id") @db.Uuid
  stripePaymentIntentId String                   @map("stripe_payment_intent_id") @db.VarChar(255)
  amount                Decimal                  @db.Decimal(10, 2)
  reason                String                   @db.VarChar(100)
  attempts              Int                      @default(0)
  lastAttemptAt         DateTime?                @map("last_attempt_at") @db.Timestamptz(3)
  resolvedAt            DateTime?                @map("resolved_at") @db.Timestamptz(3)
  status                PendingRefundRetryStatus @default(pending)
  errorLog              String?                  @map("error_log") @db.Text
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([sessionId])
  @@map("pending_refund_retries")
}

enum PendingRefundRetryStatus {
  pending
  resolved
  failed
}
