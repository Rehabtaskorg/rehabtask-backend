model Dispute {
  id              String        @id @default(uuid()) @db.Uuid
  ticketId        String        @unique @map("ticket_id") @db.VarChar(20)
  userId          String        @map("user_id") @db.Uuid
  bookingId       String?       @map("booking_id") @db.Uuid
  assignedAdminId String?       @map("assigned_admin_id") @db.Uuid
  title           String?       @db.VarChar(255)
  type            DisputeType
  description     String        @db.Text
  status          DisputeStatus @default(open)
  resolution      String?       @db.Text
  resolvedAt      DateTime?     @map("resolved_at") @db.Timestamptz(3)
  resolvedBy      String?       @map("resolved_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User     @relation("DisputeFiledBy", fields: [userId], references: [id], onDelete: Cascade)
  booking       Booking? @relation(fields: [bookingId], references: [id])
  assignedAdmin User?    @relation("DisputeAssignedAdmin", fields: [assignedAdminId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([ticketId])
  @@index([assignedAdminId])
  @@map("disputes")
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String    @db.VarChar(100)
  title      String    @db.VarChar(255)
  message    String    @db.Text
